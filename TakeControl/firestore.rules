rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getChallenge(challengeId) {
      return get(/databases/$(database)/documents/challenges/$(challengeId)).data;
    }

    function isMember(challengeId) {
      let challenge = getChallenge(challengeId);
      return request.auth.uid == challenge.createdBy ||
             request.auth.uid in challenge.get('memberIds', []);
    }

    function isPublic(challengeId) {
      return getChallenge(challengeId).get('isPublic', false) == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId);
        allow create: if isSignedIn();
      }
    }

    match /user_stats/{userId} {
      allow read, write: if isUser(userId);
    }

    match /challenges/{challengeId} {
      // Allow getting an individual challenge if signed in.
      // Privacy is enforced at the listing/searching level and for sub-collections.
      allow get: if isSignedIn();

      // Only allow listing challenges that are public, or where the user is a member/creator.
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberIds ||
        resource.data.isPublic == true ||
        (resource.data.shareCode != null && request.query.limit <= 1)
      );

      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          (
            request.auth.uid in resource.data.memberIds ||
            (resource.data.shareCode != null && request.auth.uid in request.resource.data.memberIds) ||
            (resource.data.isPublic == true && request.auth.uid in request.resource.data.memberIds)
          )
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /tasks/{taskId} {
        // Only members, creators, or those looking at public challenges can read tasks.
        allow read: if isSignedIn() && (isMember(challengeId) || isPublic(challengeId));

        allow write: if isSignedIn()
                     && request.auth.uid == getChallenge(challengeId).createdBy
                     && getChallenge(challengeId).status in ['draft', 'active'];
      }

      match /progress/{progressId} {
        allow read: if isSignedIn() && isMember(challengeId);

        allow create, update: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && isMember(challengeId);
      }

      match /feed/{postId} {
        allow read: if isSignedIn() && (isMember(challengeId) || isPublic(challengeId));
        allow create: if isSignedIn() && isMember(challengeId);
      }
    }


  }
}
