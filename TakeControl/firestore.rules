rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getChallenge(challengeId) {
      return get(/databases/$(database)/documents/challenges/$(challengeId)).data;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId);
        allow create: if isSignedIn();
      }
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberIds ||
        (resource.data.shareCode != null && request.query.limit <= 1)
      );

      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          (
            request.auth.uid in resource.data.memberIds ||
            (resource.data.shareCode != null && request.auth.uid in request.resource.data.memberIds)
          )
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /tasks/{taskId} {
        allow read: if isSignedIn() && (
          request.auth.uid == getChallenge(challengeId).createdBy ||
          request.auth.uid in getChallenge(challengeId).memberIds
        );

        allow write: if isSignedIn()
                     && request.auth.uid == getChallenge(challengeId).createdBy
                     && getChallenge(challengeId).status in ['draft', 'active'];
      }

      match /progress/{progressId} {
        allow read: if isSignedIn() && (
          request.auth.uid == getChallenge(challengeId).createdBy ||
          request.auth.uid in getChallenge(challengeId).memberIds
        );

        allow create, update: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && (
            request.auth.uid == getChallenge(challengeId).createdBy ||
            request.auth.uid in getChallenge(challengeId).memberIds
          );
      }
    }


  }
}
