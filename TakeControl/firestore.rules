rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(challenge) {
      return isSignedIn() && request.auth.uid in challenge.data.memberIds;
    }

    function isCreator(challenge) {
      return isSignedIn() && request.auth.uid == challenge.data.createdBy;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId);
    }

    match /challenges/{challengeId} {
      allow read: if isMember(resource) || isCreator(resource);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if isCreator(resource) || (
        isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
      );
      allow delete: if isCreator(resource);

      match /tasks/{taskId} {
        allow read: if isMember(get(/databases/$(database)/documents/challenges/$(challengeId)));
        allow write: if isCreator(get(/databases/$(database)/documents/challenges/$(challengeId)))
                     && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == 'draft';
      }

      match /progress/{progressId} {
        allow read: if isMember(get(/databases/$(database)/documents/challenges/$(challengeId)));
        allow create, update: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && isMember(get(/databases/$(database)/documents/challenges/$(challengeId)));
      }
    }

    match /challenges/{document=**} {
      allow read: if isSignedIn()
        && resource.data.shareCode != null
        && request.query.limit <= 1;
    }
  }
}
